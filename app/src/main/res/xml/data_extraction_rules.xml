<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not restore Recent/Favorites after reinstall or cloud restore. -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Keep installation-local history out of device-to-device transfer. -->
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
